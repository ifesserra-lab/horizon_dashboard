type DatasetSection = "canonical" | "tracking" | "graph" | "mart";

interface ExtraDownload {
    label: string;
    name: string;
    href: string;
}

// Lightweight description of a Parquet dataset, read from the file footer and
// the first row only, so the page never loads the whole dataset.
interface ParquetSummary {
    __parquet: true;
    kind: "table" | "graph";
    rows: number;
    edgeRows: number;
    columns: string[];
    edgeColumns: string[];
    sizeBytes: number;
    sample: unknown[];
    edgeSample: unknown[];
    metadata: Record<string, unknown>;
    graphStats: Record<string, unknown>;
}

interface DatasetDefinition {
    id: string;
    name: string;
    description: string;
    section: DatasetSection;
    badgeLabel: string;
    data: unknown;
    downloadHref: string;
    downloadName?: string;
    formatLabel?: string;
    extraDownloads?: ExtraDownload[];
}

interface DatasetItem {
    id: string;
    name: string;
    description: string;
    section: DatasetSection;
    badgeLabel: string;
    countValue: number;
    countLabel: string;
    sizeBytes: number;
    sizeLabel: string;
    structure: string;
    sampleKeys: string[];
    downloadHref: string;
    downloadName: string;
    formatLabel: string;
    extraDownloads: ExtraDownload[];
    searchText: string;
}

interface DatasetSectionMeta {
    key: DatasetSection;
    anchorId: string;
    title: string;
    description: string;
    chipLabel: string;
    badgeClass: string;
    countClass: string;
    hoverClass: string;
    buttonClass: string;
    summarySurfaceClass: string;
    summaryValueClass: string;
    summaryDescription: string;
}

const DATA_DIR = join(process.cwd(), "src", "data");

const parquetTable = async (name: string): Promise<ParquetSummary> => {
    const summary = await readParquetSummary(join(DATA_DIR, `${name}.parquet`));
    return {
        __parquet: true,
        kind: "table",
        rows: summary.rows,
        edgeRows: 0,
        columns: summary.columns,
        edgeColumns: [],
        sizeBytes: summary.sizeBytes,
        sample: summary.sample,
        edgeSample: [],
        metadata: {},
        graphStats: {},
    };
};

const parquetGraph = async (name: string): Promise<ParquetSummary> => {
    const nodes = await readParquetSummary(join(DATA_DIR, `${name}.nodes.parquet`));
    const edges = await readParquetSummary(join(DATA_DIR, `${name}.edges.parquet`));
    const metaPath = join(DATA_DIR, `${name}.meta.json`);
    const meta = JSON.parse(readFileSync(metaPath, "utf8"));
    return {
        __parquet: true,
        kind: "graph",
        rows: nodes.rows,
        edgeRows: edges.rows,
        columns: nodes.columns,
        edgeColumns: edges.columns,
        sizeBytes:
            nodes.sizeBytes + edges.sizeBytes + Buffer.byteLength(readFileSync(metaPath)),
        sample: nodes.sample,
        edgeSample: edges.sample,
        metadata: meta.metadata ?? {},
        graphStats: meta.graph_stats ?? {},
    };
};

const isParquetSummary = (data: unknown): data is ParquetSummary =>
    Boolean(data) && typeof data === "object" && (data as ParquetSummary).__parquet === true;

const isObjectRecord = (
    value: unknown,
): value is Record<string, unknown> =>
    Boolean(value) && typeof value === "object" && !Array.isArray(value);

const isGraphDataset = (
    data: unknown,
): data is {
    metadata?: Record<string, unknown>;
    graph_stats?: Record<string, unknown>;
    graph: { nodes?: unknown[]; edges?: unknown[] };
} => {
    if (!isObjectRecord(data) || !isObjectRecord(data.graph)) {
        return false;
    }

    return Array.isArray(data.graph.nodes) && Array.isArray(data.graph.edges);
};

const isGraphManifestDataset = (
    data: unknown,
): data is {
    metadata?: Record<string, unknown>;
    graphs: unknown[];
} => isObjectRecord(data) && Array.isArray(data.graphs);

const buildStructurePreview = (data: unknown) => {
    if (isParquetSummary(data)) {
        if (data.kind === "graph") {
            return JSON.stringify(
                {
                    metadata: data.metadata,
                    graph_stats: data.graphStats,
                    node_columns: data.columns,
                    edge_columns: data.edgeColumns,
                    sample_nodes: data.sample.slice(0, 1),
                    sample_edges: data.edgeSample.slice(0, 1),
                },
                null,
                2,
            );
        }
        return JSON.stringify(
            { columns: data.columns, first_record: data.sample[0] ?? {} },
            null,
            2,
        );
    }

    if (Array.isArray(data)) {
        return JSON.stringify(data[0] ?? {}, null, 2);
    }

    if (isGraphDataset(data)) {
        return JSON.stringify(
            {
                metadata: data.metadata ?? {},
                graph_stats: data.graph_stats ?? {},
                sample_nodes: data.graph.nodes.slice(0, 1),
                sample_edges: data.graph.edges.slice(0, 1),
            },
            null,
            2,
        );
    }

    if (isGraphManifestDataset(data)) {
        return JSON.stringify(
            {
                metadata: data.metadata ?? {},
                sample_graphs: data.graphs.slice(0, 2),
            },
            null,
            2,
        );
    }

    return JSON.stringify(data, null, 2);
};

const buildCountValue = (data: unknown) => {
    if (isParquetSummary(data)) {
        return data.rows;
    }

    if (isGraphDataset(data)) {
        return data.graph.nodes.length;
    }

    if (isGraphManifestDataset(data)) {
        return data.graphs.length;
    }

    if (Array.isArray(data)) {
        return data.length;
    }

    if (data && typeof data === "object") {
        return Object.keys(data).length;
    }

    return 0;
};

const buildCountLabel = (data: unknown) => {
    if (isParquetSummary(data)) {
        return data.kind === "graph"
            ? `${data.rows} nós · ${data.edgeRows} arestas`
            : `${data.rows} registros`;
    }

    if (isGraphDataset(data)) {
        return `${data.graph.nodes.length} nós · ${data.graph.edges.length} arestas`;
    }

    if (isGraphManifestDataset(data)) {
        return `${data.graphs.length} grafos`;
    }

    if (Array.isArray(data)) {
        return `${data.length} registros`;
    }

    if (data && typeof data === "object") {
        return `${Object.keys(data).length} blocos`;
    }

    return "Sem contagem";
};

const buildSizeBytes = (data: unknown) =>
    isParquetSummary(data)
        ? data.sizeBytes
        : Buffer.byteLength(JSON.stringify(data), "utf8");

const buildSizeLabel = (data: unknown) => {
    const bytes = buildSizeBytes(data);

    if (bytes < 1024) {
        return `${bytes} B`;
    }

    if (bytes < 1024 * 1024) {
        return `${(bytes / 1024).toFixed(1)} KB`;
    }

    return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
};

const buildSampleKeys = (data: unknown) => {
    if (isParquetSummary(data)) {
        return data.columns.slice(0, 6);
    }

    if (isGraphDataset(data)) {
        const nodeKeys =
            data.graph.nodes[0] &&
            isObjectRecord(data.graph.nodes[0])
                ? Object.keys(data.graph.nodes[0]).slice(0, 3)
                : [];
        const edgeKeys =
            data.graph.edges[0] &&
            isObjectRecord(data.graph.edges[0])
                ? Object.keys(data.graph.edges[0]).slice(0, 3)
                : [];

        return [
            "metadata",
            "graph_stats",
            ...nodeKeys.map((key) => `node.${key}`),
            ...edgeKeys.map((key) => `edge.${key}`),
        ].slice(0, 6);
    }

    if (isGraphManifestDataset(data)) {
        const firstGraph = data.graphs[0];
        if (isObjectRecord(firstGraph)) {
            return Object.keys(firstGraph).slice(0, 6);
        }

        return ["metadata", "graphs"];
    }

    if (Array.isArray(data)) {
        const firstItem = data[0];
        if (firstItem && typeof firstItem === "object" && !Array.isArray(firstItem)) {
            return Object.keys(firstItem).slice(0, 6);
        }
        return [];
    }

    if (data && typeof data === "object") {
        return Object.keys(data).slice(0, 6);
    }

    return [];
};

const buildSearchText = (
    name: string,
    description: string,
    badgeLabel: string,
    sampleKeys: string[],
) => [name, description, badgeLabel, ...sampleKeys].join(" ").toLowerCase();

const createDataset = ({
    id,
    name,
    description,
    section,
    badgeLabel,
    data,
    downloadHref,
    downloadName,
    formatLabel,
    extraDownloads,
}: DatasetDefinition): DatasetItem => {
    const sampleKeys = buildSampleKeys(data);
    const sizeBytes = buildSizeBytes(data);

    return {
        id,
        name,
        description,
        section,
        badgeLabel,
        countValue: buildCountValue(data),
        countLabel: buildCountLabel(data),
        sizeBytes,
        sizeLabel: buildSizeLabel(data),
        structure: buildStructurePreview(data),
        sampleKeys,
        downloadHref,
        downloadName: downloadName ?? name,
        formatLabel: formatLabel ?? "JSON",
        extraDownloads: extraDownloads ?? [],
        searchText: buildSearchText(name, description, badgeLabel, sampleKeys),
    };
};

