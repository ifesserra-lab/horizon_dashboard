                <div class="absolute -top-24 right-0 h-56 w-56 rounded-full bg-premium-accent/10 blur-3xl"></div>
                <div class="absolute bottom-0 left-0 h-48 w-48 rounded-full bg-premium-accent/10 blur-3xl"></div>
            </div>

            <div class="relative space-y-8">
                <div class="flex flex-wrap gap-2">
                    <span class="inline-flex items-center gap-2 rounded-full border border-premium-accent/20 bg-premium-accent/[0.08] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.22em] text-premium-accent">
                        Catálogo técnico
                    </span>
                    <span class="inline-flex items-center gap-2 rounded-full border border-premium-accent/20 bg-premium-accent/[0.08] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.22em] text-premium-accent">
                        Download direto Parquet
                    </span>
                </div>

                <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1.6fr)_minmax(320px,0.8fr)] gap-8 items-start">
                    <div class="space-y-4">
                        <h1 class="text-4xl md:text-5xl font-bold font-display tracking-tight text-text-main leading-tight">
                            Dados <span class="text-premium-accent">abertos</span>
                        </h1>
                        <p class="text-text-secondary max-w-3xl text-base leading-relaxed">
                            Repositório público dos arquivos que alimentam o portal Horizon.
                            Use esta página para baixar datasets em Parquet, navegar por bases
                            canônicas, rastreabilidade, grafos e agregados analíticos, além de
                            inspecionar rapidamente a estrutura esperada de cada arquivo.
                        </p>
                        <p class="text-sm text-text-secondary max-w-3xl">
                            Dados sob licença
                            <a
                                href="https://creativecommons.org/licenses/by/4.0/deed.pt-br"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Licença CC BY 4.0 (abre em nova aba)"
                                class="font-bold text-premium-accent hover:underline"
                            >
                                CC BY 4.0
                            </a>
                            — ao reutilizar, cite o Ifes/Horizon.
                        </p>
                        <p class="text-sm text-text-secondary max-w-3xl">
                            Para agentes de IA:
                            <a
                                href={`${import.meta.env.BASE_URL}llms.txt`}
                                class="font-bold text-premium-accent hover:underline"
                                >llms.txt</a
                            >
                            — semântica dos dados (entidades, campos,
                            relacionamentos e métricas) para entender e processar
                            os arquivos.
                        </p>

                        <div class="flex flex-wrap gap-3 pt-2">
                            {datasetSections.map((section) => (
                                <a
                                    href={`#${section.anchorId}`}
                                    class="inline-flex items-center gap-2 rounded-2xl border border-border-main bg-track px-4 py-2 text-sm font-bold text-text-main transition-colors hover:border-premium-accent/20 hover:bg-premium-accent/[0.08]"
                                >
                                    {section.title}
                                </a>
                            ))}
                            <a
                                href="#open-data-guide"
                                class="inline-flex items-center gap-2 rounded-2xl border border-border-main bg-track px-4 py-2 text-sm font-bold text-text-main transition-colors hover:border-premium-accent/20 hover:bg-premium-accent/[0.08]"
                            >
                                Como usar
                            </a>
                        </div>
                    </div>

                    <div class="rounded-[2rem] border border-border-main bg-track p-5 backdrop-blur-sm">
                        <p class="text-[11px] font-bold uppercase tracking-[0.24em] text-text-muted">
                            Leitura rápida
                        </p>
                        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
                            {datasetSections.map((section) => (
                                <div class={section.summarySurfaceClass}>
                                    <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-text-secondary">
                                        {section.title}
                                    </p>
