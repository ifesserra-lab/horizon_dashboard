// Identidade visual única (verde institucional) para todas as categorias.
const sectionBadgeClass =
    "border-premium-accent/20 bg-premium-accent/10 text-premium-accent";
const sectionCountClass = "border-border-main bg-track text-text-secondary";
const sectionHoverClass = "hover:border-premium-accent/40";
const sectionButtonClass =
    "border-premium-accent/20 bg-premium-accent/10 text-premium-accent hover:bg-premium-accent/20";
const sectionSummarySurfaceClass =
    "rounded-2xl border border-border-main bg-track p-4";
const sectionSummaryValueClass = "text-premium-accent";

const datasetSectionsMeta: DatasetSectionMeta[] = [
    {
        key: "canonical",
        anchorId: "datasets-canonical",
        title: "Bases canônicas",
        description: "Entidades normalizadas, recortes de pessoas e vínculos estruturantes do portal.",
        chipLabel: "Base",
        badgeClass: sectionBadgeClass,
        countClass: sectionCountClass,
        hoverClass: sectionHoverClass,
        buttonClass: sectionButtonClass,
        summarySurfaceClass: sectionSummarySurfaceClass,
        summaryValueClass: sectionSummaryValueClass,
        summaryDescription:
            "Entidades prontas para reconciliação e navegação.",
    },
    {
        key: "tracking",
        anchorId: "datasets-tracking",
        title: "Rastreabilidade e proveniência",
        description: "Arquivos de auditoria, rastreamento e histórico de mudanças da base.",
        chipLabel: "Proveniência",
        badgeClass: sectionBadgeClass,
        countClass: sectionCountClass,
        hoverClass: sectionHoverClass,
        buttonClass: sectionButtonClass,
        summarySurfaceClass: sectionSummarySurfaceClass,
        summaryValueClass: sectionSummaryValueClass,
        summaryDescription:
            "Fontes, evidências e alterações registradas para auditoria.",
    },
    {
        key: "graph",
        anchorId: "datasets-graphs",
        title: "Grafos e manifestos",
        description: "Redes globais, recortes por perfil e catálogos de grafos por grupo.",
        chipLabel: "Redes",
        badgeClass: sectionBadgeClass,
        countClass: sectionCountClass,
        hoverClass: sectionHoverClass,
        buttonClass: sectionButtonClass,
        summarySurfaceClass: sectionSummarySurfaceClass,
        summaryValueClass: sectionSummaryValueClass,
        summaryDescription:
            "Recortes relacionais e catálogos para exploração de redes.",
    },
    {
        key: "mart",
        anchorId: "datasets-mart",
        title: "Agregados analíticos",
        description: "Agregações prontas para indicadores, gráficos e leituras sintéticas.",
        chipLabel: "Agregados",
        badgeClass: sectionBadgeClass,
        countClass: sectionCountClass,
        hoverClass: sectionHoverClass,
        buttonClass: sectionButtonClass,
        summarySurfaceClass: sectionSummarySurfaceClass,
        summaryValueClass: sectionSummaryValueClass,
        summaryDescription:
            "Agregações prontas para séries, comparativos e painéis.",
    },
];

const datasetSections = datasetSectionsMeta.map((section) => ({
    ...section,
    datasets: datasets.filter((dataset) => dataset.section === section.key),
}));

const canonicalDatasets = datasetSections.find((section) => section.key === "canonical")?.datasets || [];
const trackingDatasets = datasetSections.find((section) => section.key === "tracking")?.datasets || [];
const graphDatasets = datasetSections.find((section) => section.key === "graph")?.datasets || [];
const martDatasets = datasetSections.find((section) => section.key === "mart")?.datasets || [];
const totalDatasets = datasets.length;
const totalItems = datasets.reduce((sum, dataset) => sum + dataset.countValue, 0);
const totalDownloadBytes = datasets.reduce(
    (sum, dataset) => sum + dataset.sizeBytes,
    0,
);

const formatSummaryBytes = (bytes: number) => {
    if (bytes < 1024 * 1024) {
        return `${(bytes / 1024).toFixed(0)} KB`;
    }

    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
};

const latestIngestionDate = [...(ingestionRunsCanonical as Array<Record<string, string | null>>)]
    .map((run) => run.finished_at || run.started_at || "")
    .filter(Boolean)
    .sort()
    .at(-1);

const formatDateTime = (value: string | undefined) => {
    if (!value) {
        return "Sem data";
    }

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
        return value;
    }

    return date.toLocaleString("pt-BR", {
        dateStyle: "short",
        timeStyle: "short",
    });
};

const catalogHighlights = [
    {
        label: "Datasets disponíveis",
        value: totalDatasets,
        description: "Arquivos prontos para download direto em JSON.",
        accentClass: "text-premium-accent",
        surfaceClass: "bg-premium-accent/[0.08] border-premium-accent/20",
    },
    {
        label: "Entradas catalogadas",
        value: totalItems.toLocaleString("pt-BR"),
        description: "Registros, nós ou grafos somados entre as categorias catalogadas.",
        accentClass: "text-premium-accent",
        surfaceClass: "bg-premium-accent/[0.08] border-premium-accent/20",
    },
    {
        label: "Peso do catálogo",
        value: formatSummaryBytes(totalDownloadBytes),
        description: "Estimativa de navegação e prévia estrutural exibida nesta página.",
        accentClass: "text-premium-accent",
        surfaceClass: "bg-premium-accent/[0.08] border-premium-accent/20",
    },
    {
        label: "Última ingestão",
        value: formatDateTime(latestIngestionDate),
        description: "Referência temporal da última execução catalogada na base canônica.",
        accentClass: "text-premium-accent",
        surfaceClass: "bg-premium-accent/[0.08] border-premium-accent/20",
    },
];

const guideCards = [
    {
        title: "Arquivos JSON prontos para download",
        body: "Cada card aponta para o arquivo JSON gerado no build. O download é direto, sem depender da navegação do portal.",
    },
    {
        title: "A estrutura serve de referência",
        body: "A prévia mostra o primeiro registro ou o bloco raiz, útil como referência da estrutura ao integrar os dados.",
    },
    {
        title: "Base e análise separadas",
        body: "As bases canônicas preservam entidades e vínculos. Os agregados já chegam prontos para indicadores, séries e painéis.",
    },
    {
        title: "Rastreabilidade dos dados",
        body: "Os arquivos de rastreamento, evidências e histórico de mudanças mostram de onde veio cada atributo e como o registro mudou entre as cargas.",
    },
    {
        title: "Grafos de colaboração",
        body: "Os arquivos de grafos já incluem metadados, estatísticas de rede e arestas para estudos de colaboração e relacionamento.",
    },
];
