                    </button>
                    <button
                        type="button"
                        aria-pressed="false"
                        class="dataset-filter-chip inline-flex items-center rounded-full border border-border-main bg-track px-4 py-2 text-sm font-bold text-text-secondary transition-colors hover:border-premium-accent/20 hover:text-text-main"
                        data-dataset-filter="tracking"
                    >
                        Proveniência
                    </button>
                    <button
                        type="button"
                        aria-pressed="false"
                        class="dataset-filter-chip inline-flex items-center rounded-full border border-border-main bg-track px-4 py-2 text-sm font-bold text-text-secondary transition-colors hover:border-premium-accent/20 hover:text-text-main"
                        data-dataset-filter="graph"
                    >
                        Redes
                    </button>
                    <button
                        type="button"
                        aria-pressed="false"
                        class="dataset-filter-chip inline-flex items-center rounded-full border border-border-main bg-track px-4 py-2 text-sm font-bold text-text-secondary transition-colors hover:border-premium-accent/20 hover:text-text-main"
                        data-dataset-filter="mart"
                    >
                        Agregados
                    </button>
                </div>
            </div>
        </section>

        {datasetSections.map((section) => (
            <section
                id={section.anchorId}
                class="space-y-5"
                data-dataset-section={section.key}
            >
                <div class="flex items-end justify-between gap-4">
                    <div>
                        <h2 class="text-2xl font-bold font-display text-text-main">
                            {section.title}
                        </h2>
                        <p class="text-text-secondary mt-1">
                            {section.description} em <span class="font-mono text-text-main">src/data</span>.
                        </p>
                    </div>
                    <span class="text-xs font-bold uppercase tracking-[0.18em] text-text-muted">
                        {section.datasets.length} arquivos
                    </span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                    {section.datasets.map((dataset) => (
                        <article
                            class={`glass-card p-6 flex flex-col gap-5 h-full transition-all duration-300 ${section.hoverClass}`}
                            data-dataset-card
                            data-dataset-type={section.key}
                            data-search={dataset.searchText}
                        >
                            <div class="flex items-start justify-between gap-4">
                                <div class="space-y-2">
                                    <span class={`inline-flex items-center rounded-full border px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] ${section.badgeClass}`}>
                                        {dataset.badgeLabel}
                                    </span>
                                    <h3 class="text-lg font-bold text-text-main font-display leading-snug break-all">
                                        {dataset.name}
                                    </h3>
                                </div>
                                <span class={`rounded-full border px-3 py-1 text-xs font-bold ${section.countClass}`}>
                                    {dataset.countLabel}
                                </span>
                            </div>

                            <p class="text-sm text-text-secondary leading-relaxed">
                                {dataset.description}
                            </p>

                            <div class="grid grid-cols-2 gap-3 text-sm">
                                <div class="rounded-2xl border border-border-main bg-track px-4 py-3">
                                    <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-text-secondary">Tamanho</p>
                                    <p class="mt-1 font-bold text-text-main">{dataset.sizeLabel}</p>
                                </div>
                                <div class="rounded-2xl border border-border-main bg-track px-4 py-3">
                                    <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-text-secondary">Origem</p>
                                    <p class="mt-1 font-mono text-xs text-text-main">src/data</p>
                                </div>
                            </div>

                            <div class="space-y-2">
                                <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-text-secondary">
                                    Campos visíveis na prévia
                                </p>
                                <div class="flex flex-wrap gap-2">
                                    {dataset.sampleKeys.length > 0 ? (
                                        dataset.sampleKeys.map((field) => (
                                            <span class="inline-flex items-center rounded-full border border-border-main bg-[var(--tag-bg)] px-2.5 py-1 text-[10px] font-bold text-text-secondary">
                                                {field}
                                            </span>
                                        ))
                                    ) : (
                                        <span class="text-sm text-text-secondary">Sem amostra de campos.</span>
                                    )}
                                </div>
                            </div>

                            <details class="group/details mt-1">
                                <summary class="cursor-pointer list-none flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-premium-accent transition-colors hover:text-premium-purple">
                                    <span class="group-open/details:hidden">Ver estrutura</span>
                                    <span class="hidden group-open/details:inline">Ocultar estrutura</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-open/details:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                </summary>
                                <div class="mt-3 rounded-2xl border border-border-main bg-surface p-3">
                                    <pre class="overflow-x-auto whitespace-pre text-[10px] text-text-main font-mono"><code>{dataset.structure}</code></pre>
                                </div>
                            </details>

                            <div class="mt-auto pt-4 border-t border-border-main flex items-center justify-between gap-3">
                                <span class="text-xs text-text-secondary">
                                    {dataset.formatLabel}
                                </span>
                                <a
                                    href={dataset.downloadHref}
                                    download={dataset.downloadName}
                                    class={`inline-flex items-center gap-2 rounded-xl border px-4 py-2 text-sm font-bold transition-colors ${section.buttonClass}`}
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
                                    Download
                                </a>
                            </div>
                            {dataset.extraDownloads.length > 0 && (
                                <div class="flex flex-wrap gap-2 pt-3">
                                    {dataset.extraDownloads.map((extra) => (
                                        <a
                                            href={extra.href}
                                            download={extra.name}
                                            class={`inline-flex items-center gap-2 rounded-xl border px-3 py-1.5 text-xs font-bold transition-colors ${section.buttonClass}`}
                                        >
                                            {extra.label} ({extra.name.split(".").pop()})
                                        </a>
                                    ))}
                                </div>
                            )}
                        </article>
                    ))}
                </div>
            </section>
        ))}

        <div
            id="datasetEmptyState"
            class="hidden flex-col items-center justify-center py-20 text-center glass-card border border-dashed border-border-main"
        >
            <div class="w-16 h-16 rounded-3xl bg-track border border-border-main flex items-center justify-center text-text-secondary mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path><path d="M8 11h6"></path></svg>
            </div>
            <h3 class="text-xl font-bold font-display text-text-main">Nenhum dataset encontrado</h3>
            <p class="mt-2 max-w-md text-text-secondary">
                Ajuste sua busca ou volte para o filtro <strong>Todos</strong> para ver o catálogo completo.
            </p>
        </div>
    </div>
</Layout>

<script>
    import { normalizeSearchText } from "../../lib/search";

    function setupOpenDataCatalog() {
        const root = document.getElementById("open-data-catalog");
        if (!root || root.dataset.initialized === "true") return;
        root.dataset.initialized = "true";

        const searchInput = document.getElementById(
            "datasetSearch",
        ) as HTMLInputElement | null;
        const resetButton = document.getElementById("resetDatasetSearch");
        const visibleCountLabel = document.getElementById("datasetVisibleCount");
        const emptyState = document.getElementById("datasetEmptyState");
        const cards = Array.from(
            document.querySelectorAll<HTMLElement>("[data-dataset-card]"),
        );
        const sections = Array.from(
            document.querySelectorAll<HTMLElement>("[data-dataset-section]"),
        );
        const filterButtons = Array.from(
            document.querySelectorAll<HTMLButtonElement>("[data-dataset-filter]"),
        );

        let activeFilter = "all";

        const syncFilterButtonState = () => {
            filterButtons.forEach((button) => {
                const isActive = button.dataset.datasetFilter === activeFilter;
                button.setAttribute("aria-pressed", String(isActive));
                button.classList.toggle("border-premium-accent/20", isActive);
                button.classList.toggle("bg-premium-accent/[0.08]", isActive);
                button.classList.toggle("text-premium-accent", isActive);
                button.classList.toggle("border-border-main", !isActive);
                button.classList.toggle("bg-track", !isActive);
                button.classList.toggle("text-text-secondary", !isActive);
            });
        };

        const applyFilters = () => {
            const query = normalizeSearchText(searchInput?.value || "");
            let visibleCards = 0;

            if (query) {
                resetButton?.classList.remove("hidden");
            } else {
                resetButton?.classList.add("hidden");
            }

            cards.forEach((card) => {
                const matchesType =
                    activeFilter === "all" ||
                    card.dataset.datasetType === activeFilter;
                const matchesQuery =
                    !query ||
                    normalizeSearchText(card.dataset.search || "").includes(query);
                const isVisible = matchesType && matchesQuery;

                card.classList.toggle("hidden", !isVisible);
                if (isVisible) visibleCards += 1;
            });

            sections.forEach((section) => {
                const visibleSectionCards = section.querySelectorAll(
                    "[data-dataset-card]:not(.hidden)",
                ).length;
                section.classList.toggle("hidden", visibleSectionCards === 0);
            });

            if (visibleCountLabel) {
                visibleCountLabel.textContent = String(visibleCards);
            }

            emptyState?.classList.toggle("hidden", visibleCards !== 0);
            emptyState?.classList.toggle("flex", visibleCards === 0);
        };

        filterButtons.forEach((button) => {
            button.addEventListener("click", () => {
                activeFilter = button.dataset.datasetFilter || "all";
                syncFilterButtonState();
                applyFilters();
            });
        });

        searchInput?.addEventListener("input", applyFilters);
        resetButton?.addEventListener("click", () => {
            if (searchInput) {
                searchInput.value = "";
            }
            applyFilters();
            searchInput?.focus();
        });

        syncFilterButtonState();
        applyFilters();
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupOpenDataCatalog, {
            once: true,
        });
    } else {
        setupOpenDataCatalog();
    }

    document.addEventListener("astro:after-swap", setupOpenDataCatalog);
</script>
